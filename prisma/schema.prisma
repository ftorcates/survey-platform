generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SurveyType {
  CUSTOM
  FIXED_SCALE
}

model Survey {
  id                  String     @id @default(cuid())
  title               String
  description         String?
  image               String?
  organization        String?
  department          String?
  subdepartment       String?
  includeLikertTable  Boolean    @default(false)
  isMandatory         Boolean    @default(true)
  type                SurveyType @default(CUSTOM)
  requireDemographics Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  authorId            String?
  questions           Question[]
  responses           Response[]
  author              User?          @relation(fields: [authorId], references: [id])
  options             Option[]
  blocks              QuestionBlock[]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  surveys       Survey[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Question {
  id             String       @id @default(cuid())
  surveyId       String
  text           String
  type           QuestionType
  order          Int
  nextQuestionId String?
  blockId        String?
  block          QuestionBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)
  answers        Answer[]
  options        Option[]
  survey         Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
}

model QuestionBlock {
  id          String     @id @default(cuid())
  surveyId    String
  title       String     @default("Bloque 1")
  description String?
  order       Int        @default(1)
  questions   Question[]
  survey      Survey     @relation(fields: [surveyId], references: [id], onDelete: Cascade)
}

model Option {
  id             String    @id @default(cuid())
  questionId     String?
  surveyId       String?
  text           String
  nextQuestionId String?
  answers        Answer[]
  question       Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  survey         Survey?   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
}

model Response {
  id        String   @id @default(cuid())
  surveyId  String
  createdAt DateTime @default(now())
  ageGroup  String?
  sex       String?
  location  String?
  answers   Answer[]
  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
}

model Answer {
  id         String   @id @default(cuid())
  responseId String
  questionId String
  textValue  String?
  optionId   String?
  option     Option?  @relation(fields: [optionId], references: [id])
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
}

enum QuestionType {
  TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}
